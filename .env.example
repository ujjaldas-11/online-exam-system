# Environment Configuration
APP_ENV=development
APP_NAME=Examify
APP_URL=http://localhost

# Database Credentials
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=examify
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_SSL=false
# DB_SSL_CA=/path/to/ca.crt

# Session & Security
SESSION_LIFETIME=1800
CSRF_SECRET=examify_secure_csrf_secret_key_change_in_production

# Real-Time WebSocket Configuration
WS_ENABLED=true
WS_HOST=0.0.0.0
WS_PORT=8085
WS_IPC_HOST=127.0.0.1
WS_IPC_PORT=8086
WS_PUBLIC_URL=ws://localhost:8085
