# Application Environment: 'development' or 'production'
# In 'development' mode: browser caching is disabled and assets use cache-busting (?v=timestamp)
# In 'production' mode: browser caching and HTTP expiration headers are enabled
APP_ENV=development

# Database Configuration
DB_HOST=localhost
DB_DATABASE=examify
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
